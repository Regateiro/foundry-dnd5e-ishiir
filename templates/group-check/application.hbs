<form class="group-check-form" autocomplete="off">
{{#if active}}
  <h2>{{localize "DND5E.GroupCheck"}}<span>&mdash; {{skillLabel}}</span></h2>
  {{#if hasEntries}}
  <table class="group-check-table">
    <thead>
      <tr>
        <th>{{localize "DND5E.GroupCheckActor"}}</th>
        <th>{{localize "DND5E.GroupCheckRoll"}}</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
    {{#each entries}}
      <tr>
        <td>{{this.name}}</td>
        <td><input type="number" data-actor-id="{{this.id}}" value="{{this.total}}"></td>
        <td><a class="remove-actor" data-actor-id="{{this.id}}" title="{{localize "DND5E.GroupCheckRemove"}}"><i class="fas fa-times"></i></a></td>
      </tr>
    {{/each}}
    </tbody>
  </table>
  <p class="group-check-participants">{{localize "DND5E.GroupCheckParticipants"}}: {{count}}</p>
  {{else}}
  <p class="group-check-waiting">{{localize "DND5E.GroupCheckWaiting"}}</p>
  {{/if}}
  <div class="group-check-buttons">
    <button class="end-check" type="button">{{localize "DND5E.GroupCheckEnd"}}</button>
    <button class="cancel-check" type="button">{{localize "DND5E.GroupCheckCancel"}}</button>
  </div>
{{else}}
  <h2>{{localize "DND5E.GroupCheck"}}</h2>
  <label>{{localize "DND5E.GroupCheckPrompt"}}</label>
  <select name="skill">
    {{#each skills}}
    <option value="{{this.key}}">{{this.label}}</option>
    {{/each}}
  </select>
  <button class="start-check" type="button">{{localize "DND5E.GroupCheckStart"}}</button>
{{/if}}
</form>
