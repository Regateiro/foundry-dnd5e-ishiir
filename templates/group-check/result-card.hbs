<div class="group-check-result">
<h3>{{localize "DND5E.GroupCheckResult"}} &mdash; {{skillLabel}}</h3>
<div class="group-check-average">{{average}}</div>
<table>
    <thead>
      <tr>
        <th>{{localize "DND5E.GroupCheckActor"}}</th>
        <th>{{localize "DND5E.GroupCheckRoll"}}</th>
      </tr>
    </thead>
    <tbody>
    {{#each entries}}
      <tr>
        <td>{{this.name}}</td>
        <td>{{this.total}}</td>
      </tr>
    {{/each}}
    </tbody>
  </table>
  <hr>
  <p class="group-check-footer">{{localize "DND5E.GroupCheckTotal"}}: {{sum}}  |  {{localize "DND5E.GroupCheckParticipants"}}: {{count}}</p>
