{
  "name": "Tranquil Spirit",
  "type": "feat",
  "system": {
    "description": {
      "value": "<p>As long as you have at least 1 hit point, you regain hit points equal to half your paladin level + your Charisma modifier at the start of every one of your turns.</p><p>If you deal damage to a creature, force it to make a Saving Throw, or otherwise target it with a harmful effect, this feature stops working until the end of your next turn.</p>",
