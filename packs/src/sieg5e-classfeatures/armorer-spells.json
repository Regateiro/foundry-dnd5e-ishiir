  "system": {
    "description": {
      "value": "<p>You always have certain spells prepared after you reach particular levels in this class, as shown in the Armorer Spells table. These spells count as artificer spells for you, but they don't count against the number of artificer spells you prepare.</p><div style=\"width: 100%;\"><table style=\"width: 100%;\"><caption>Armorer Spells</caption><thead><tr><th scope=\"col\">Artificer Level</th><th scope=\"col\">Spell</th></tr></thead><tbody><tr><td>3rd</td><td>Magic Missile, Shield</td></tr><tr><td>5th</td><td>Mirror Image, Shatter</td></tr><tr><td>9th</td><td>Hypnotic Pattern, Lightning Bolt</td></tr><tr><td>13th</td><td>Fire Shield, Greater Invisibility</td></tr><tr><td>17th</td><td>Passwall, Wall of Force</td></tr></tbody></table></div>",
