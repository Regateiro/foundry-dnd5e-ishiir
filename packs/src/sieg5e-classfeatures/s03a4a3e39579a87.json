{
  "name": "Artillerist Spells",
  "type": "feat",
  "system": {
    "description": {
      "value": "<p>You always have certain spells prepared after you reach particular levels in this class, as shown in the Artillerist Spells table. These spells count as artificer spells for you, but they don't count against the number of artificer spells you prepare.</p><div style=\"width: 100%;\"><table style=\"width: 100%;\"><caption>Artillerist Spells</caption><thead><tr><th scope=\"col\">Artificer Level</th><th scope=\"col\">Spell</th></tr></thead><tbody><tr><td>3rd</td><td>Shield, Thunderwave</td></tr><tr><td>5th</td><td>Scorching Ray, Shatter</td></tr><tr><td>9th</td><td>Fireball, Wind Wall</td></tr><tr><td>13th</td><td>Ice Storm, Wall of Fire</td></tr><tr><td>17th</td><td>Cone of Cold, Wall of Force</td></tr></tbody></table></div>",
