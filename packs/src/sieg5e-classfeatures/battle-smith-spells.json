{
  "name": "Battle Smith Spells",
  "type": "feat",
  "system": {
    "description": {
      "value": "<p>You always have certain spells prepared after you reach particular levels in this class, as shown in the Battle Smith Spells table. These spells count as artificer spells for you, but they don't count against the number of artificer spells you prepare.</p><div style=\"width: 100%;\"><table style=\"width: 100%;\"><caption>Battle Smith Spells</caption><thead><tr><th scope=\"col\">Artificer Level</th><th scope=\"col\">Spell</th></tr></thead><tbody><tr><td>3rd</td><td>Heroism, Shield</td></tr><tr><td>5th</td><td>Branding Smite, Warding Bond</td></tr><tr><td>9th</td><td>Aura of Vitality, Conjure Barrage</td></tr><tr><td>13th</td><td>Aura of Purity, Fire Shield</td></tr><tr><td>17th</td><td>Banishing Smite, Mass Cure Wounds</td></tr></tbody></table></div>",
