{
  "name": "Alchemist Spells",
  "type": "feat",
  "system": {
    "description": {
      "value": "<p>You always have certain spells prepared after you reach particular levels in this class, as shown in the Alchemist Spells table. These spells count as artificer spells for you, but they don't count against the number of artificer spells you prepare.</p><div style=\"width: 100%;\"><table style=\"width: 100%;\"><caption>Alchemist Spells</caption><thead><tr><th scope=\"col\">Artificer Level</th><th scope=\"col\">Spell</th></tr></thead><tbody><tr><td>3rd</td><td>Healing Word, Ray of Sickness</td></tr><tr><td>5th</td><td>Flaming Sphere, Melf's Acid Arrow</td></tr><tr><td>9th</td><td>Corrosion, Mass Healing Word</td></tr><tr><td>13th</td><td>Death Ward, Vitriolic Sphere</td></tr><tr><td>17th</td><td>Cloudkill, Mass Cure Wounds</td></tr></tbody></table></div>",
