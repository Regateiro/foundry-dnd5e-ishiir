{
  "name": "Improved Duplicity (Trickery Domain)",
  "type": "feat",
  "system": {
    "description": {
      "value": "<p>The illusion of your Invoke Duplicity has grown more powerful in the following ways.</p><ul><li><strong>Shared Distraction.</strong> When you and your allies make Attack Rolls against a creature within 5 feet of the illusion, the Attack Rolls have Advantage.</li><li><strong>Healing Illusion.</strong> When the illusion ends, you or a creature of your choice within 5 feet of it regains a number of Hit Points equal to your Cleric level.</li></ul>",
