{
  "name": "Aura of Protection",
  "type": "feat",
  "system": {
    "description": {
      "value": "<p>Whenever you or a friendly creature within 10 feet of you must make a Saving Throw, the creature gains a bonus to the Saving Throw equal to your Charisma modifier (with a minimum bonus of +1). You must be conscious to grant this bonus.</p><p>At 18th level, the range of this aura increases to 30 feet.</p>",
