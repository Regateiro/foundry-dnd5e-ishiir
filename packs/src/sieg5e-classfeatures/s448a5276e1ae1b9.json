  "system": {
    "description": {
      "value": "<p>When you reach a Druid level specified in the Circle of the Moon Spells table, you thereafter always have the listed spells prepared.</p><p>In addition, you can cast the spells from this feature while you're in a Wild Shape form.</p><div style=\"width: 100%;\"><table style=\"width: 100%;\"><caption>Circle of the Sea Spells</caption><thead><tr><th scope=\"col\">Druid Level</th><th scope=\"col\">Circle Spells</th></tr></thead><tbody><tr><td>3rd</td><td>Cure Wounds, Moonbeam, Starry Wisp</td></tr><tr><td>5th</td><td>Conjure Animals</td></tr><tr><td>7th</td><td>Fount of Moonlight</td></tr><tr><td>9th</td><td>Mass Cure Wounds</td></tr></tbody></table></div>",
